# Translation toolchain for tools/lean_check.
#
# Builds one image with:
#   - a pinned Rust nightly toolchain, with the components Charon's own
#     `rust-toolchain` file names (Charon runs as a custom `rustc` driver,
#     so it needs `rustc-dev` and `llvm-tools` from that exact nightly),
#   - the Charon and Aeneas binaries, from the nightly release tagged
#     nightly-2026.11.13 (Charon) and nightly-2026.11.13-0d21a9e (Aeneas),
#     fetched over HTTPS and checked against a recorded SHA-256,
#   - elan, which installs the Lean toolchain a project's `lean-toolchain`
#     file names (here, `leanprover/lean4:v4.36.0-rc2`, the version
#     Aeneas's own `backends/lean` package pins).
#
# See ../README.md for the exact commands this image is used with.

FROM docker.io/library/rust:1-slim-bookworm

# Charon and Aeneas tags to fetch. Keep in sync with README.md.
ARG CHARON_TAG=nightly-2026.11.13
ARG CHARON_SHA256=f0e7f56425c76f391dadcf246ccd0a7a7e24d9b43de10828464fd6dc5a681b3a
ARG AENEAS_TAG=nightly-2026.11.13-0d21a9e
ARG AENEAS_SHA256=39c2565790310acdfb8fe4d12a1a4d637e85c7a1672e7d4586cb7c4d9bfe446e

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
       curl ca-certificates git build-essential clang file xz-utils unzip jq \
    && rm -rf /var/lib/apt/lists/*

# --- Charon + Aeneas: prebuilt binaries, no OCaml build on this host. ---
WORKDIR /opt/aeneas-tools
RUN curl -sSL -o charon.tar.gz \
      "https://github.com/AeneasVerif/charon/releases/download/${CHARON_TAG}/charon-linux-x86_64.tar.gz" \
    && echo "${CHARON_SHA256}  charon.tar.gz" | sha256sum -c - \
    && tar -xzf charon.tar.gz \
    && rm charon.tar.gz \
    && curl -sSL -o aeneas.tar.gz \
      "https://github.com/AeneasVerif/aeneas/releases/download/${AENEAS_TAG}/aeneas-linux-x86_64.tar.gz" \
    && echo "${AENEAS_SHA256}  aeneas.tar.gz" | sha256sum -c - \
    && tar -xzf aeneas.tar.gz \
    && rm aeneas.tar.gz \
    && chmod +x charon charon-driver aeneas
ENV PATH="/opt/aeneas-tools:${PATH}"
# The Aeneas Lean standard library a generated project `require`s. Keep the
# path so a Lean project can point at it without re-downloading Aeneas.
ENV AENEAS_LEAN_BACKEND="/opt/aeneas-tools/backends/lean"

# --- Rust nightly toolchain Charon's own rust-toolchain file names. ---
RUN rustup toolchain install nightly-2026-09-17 \
      --component rustc-dev,llvm-tools,rust-src \
    && rustup default nightly-2026-09-17

# --- elan, for the Lean toolchain. Installs the toolchain a project's own
# lean-toolchain file names; nothing is pinned here beyond elan itself. ---
RUN curl -sSL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
      -o /tmp/elan-init.sh \
    && sh /tmp/elan-init.sh -y --default-toolchain none \
    && rm /tmp/elan-init.sh
ENV PATH="/root/.elan/bin:${PATH}"

WORKDIR /work
