import Lake
open Lake DSL

-- Aeneas's own `backends/lean` package, baked into the translation image at
-- this fixed path (see ../podman/Containerfile). It pulls in `mathlib`
-- transitively, at the version Aeneas's own lakefile pins
-- (`leanprover-community/mathlib4` @ `v4.36.0-rc2`).
require aeneas from "/opt/aeneas-tools/backends/lean"

package «hustleCheck» where

/-- Charon + Aeneas output: `HustleCore.lean` (the root module, generated by
hand to list the split files below) plus `HustleCore/Types.lean`,
`HustleCore/TypesExternal.lean` and `HustleCore/Funs.lean` (Aeneas output;
see ../README.md for the exact command). A separate target from
`HustleCheck`, so a re-run of the pipeline touches only this one. -/
@[default_target]
lean_lib «HustleCore» where
  srcDir := "src"

/-- The hand-written theorem and its proof, importing `HustleCore`. -/
@[default_target]
lean_lib «HustleCheck» where
  srcDir := "src"
