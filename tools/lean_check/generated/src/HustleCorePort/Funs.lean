       else ok (some fixed.Fixed.ZERO)
  else
    if y > 0#i64
    then
      if x = 0#i64
      then ok (some fixed.PI_HALF)
      else
        if x > 0#i64
        then
          if diff < 0#i64
          then fixed.atan_poly_1 y x
          else
            let o ← fixed.atan_poly_2 y x
            match o with
            | none => ok none
            | some p =>
              let f ← fixed.Fixed.wrapping_sub fixed.PI_HALF p
              ok (some f)
        else
          if diff >= 0#i64
          then
            let o ← fixed.atan_poly_2 y x
            match o with
            | none => ok none
            | some p =>
              let f ← fixed.Fixed.wrapping_sub fixed.PI_HALF p
              ok (some f)
          else
            let o ← fixed.atan_poly_1 y x
            match o with
            | none => ok none
            | some p =>
              let f ← fixed.Fixed.wrapping_add fixed.PI p
              ok (some f)
    else
      let i := fixed.PI_HALF
      let i1 ← -. i
      if x = 0#i64
      then ok (some i1)
      else
        if x > 0#i64
        then
          if diff < 0#i64
          then fixed.atan_poly_1 y x
          else
            let o ← fixed.atan_poly_2 y x
            match o with
            | none => ok none
            | some p => let f ← fixed.Fixed.wrapping_sub i1 p
                        ok (some f)
        else
          if diff >= 0#i64
          then
            let o ← fixed.atan_poly_2 y x
            match o with
            | none => ok none
            | some p => let f ← fixed.Fixed.wrapping_sub i1 p
                        ok (some f)
          else
            let o ← fixed.atan_poly_1 y x
            match o with
            | none => ok none
